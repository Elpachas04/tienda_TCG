# Copia este archivo como .env y rellena los valores
# NUNCA subas .env a GitHub

# Obligatorias: notificaciones de pedido por Telegram
TELEGRAM_BOT_TOKEN=xxxxxxxxxxxx
TELEGRAM_CHAT_ID=xxxxxxxxxxxx

# Obligatoria: envío de emails de confirmación (Brevo)
BREVO_API_KEY=xxxxxxxxxxxx

# Opcionales: seguimiento de pedidos en Notion
# Sin estas vars, el seguimiento en /seguimiento no funcionará
NOTION_TOKEN=xxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxx
